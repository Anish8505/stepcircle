rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function directFriendOf(userId) {
      return exists(/databases/$(database)/documents/userFriends/$(request.auth.uid)/friends/$(userId));
    }

    function ownsLeaderboard(leaderboardId) {
      return get(/databases/$(database)/documents/friendLeaderboards/$(leaderboardId)).data.viewerUserId == request.auth.uid;
    }

    match /users/{userId} {
      allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'displayName', 'photoUrl', 'globalLeaderboardOptIn', 'city', 'countryCode',
            'showCityOnGlobalLeaderboard', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.globalLeaderboardOptIn == false;

      // Direct friends may read only the safe profile fields stored here.
      allow read: if signedIn() && (request.auth.uid == userId || directFriendOf(userId));

      allow update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'displayName', 'photoUrl', 'globalLeaderboardOptIn', 'city', 'countryCode',
              'showCityOnGlobalLeaderboard', 'updatedAt'
            ]);
    }

    // A client may only read its own membership edge. Cloud Functions write all edges.
    match /userFriends/{userId}/friends/{friendId} {
      allow read: if signedIn() && request.auth.uid == userId;
    }

    // Raw daily steps are never visible to another client, even a direct friend.
    match /dailySteps/{dailyStepId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Each viewer receives a separate direct-friends-only leaderboard document.
    match /friendLeaderboards/{leaderboardId} {
      allow read: if signedIn() && resource.data.viewerUserId == request.auth.uid;
    }

    match /friendLeaderboards/{leaderboardId}/entries/{participantUserId} {
      allow read: if signedIn() && ownsLeaderboard(leaderboardId);
    }

    function ownsRankSnapshot(snapshotId) {
      return get(/databases/$(database)/documents/viewerFriendRankSnapshots/$(snapshotId)).data.viewerUserId == request.auth.uid;
    }

    match /viewerFriendRankSnapshots/{snapshotId} {
      allow read: if signedIn() && resource.data.viewerUserId == request.auth.uid;
    }

    match /viewerFriendRankSnapshots/{snapshotId}/entries/{participantUserId} {
      allow read: if signedIn() && ownsRankSnapshot(snapshotId);
    }

    // Global entries contain only the deliberately public display fields.
    // They are still server-written and are visible only to signed-in members.
    match /globalLeaderboard/{dateKey} {
      allow read: if signedIn();
    }

    match /globalLeaderboard/{dateKey}/entries/{participantUserId} {
      allow read: if signedIn();
    }

    // friendships, invitations, ranks, snapshots and leaderboard writes are server-only.
  }
}
